# frozen_string_literal: true

require "bundler/gem_tasks"
require "minitest/test_task"
require "rubocop/rake_task"

Minitest::TestTask.create
RuboCop::RakeTask.new

task default: %i[test rubocop]

desc "Render every fixture invoice to examples/ as XML and hybrid PDF"
task :examples do
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "en16931"
  require_relative "test/fixtures/invoices"
  FileUtils.mkdir_p("examples")
  Fixtures.each { |name, invoice| File.write("examples/#{name}.xml", EN16931::XML.cii(invoice)) }
  Fixtures.renders.each do |name, (invoice, options)|
    File.binwrite("examples/#{name}.pdf", EN16931::PDF.render(invoice, created_at: Time.utc(2026, 10, 20, 12), **options))
    puts "examples/#{name}.pdf"
  end
end

desc "Run the official validators (KoSIT for the XML, veraPDF for the PDF) over every fixture"
task :validate do
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "en16931"
  require_relative "test/fixtures/invoices"
  kosit = EN16931::Validation::KoSIT.new.install!
  vera = EN16931::Validation::VeraPDF.new
  failed = false
  puts "render                       KoSIT      veraPDF   "
  Fixtures.renders.each do |name, (invoice, options)|
    xml_report = kosit.validate(EN16931::XML.cii(invoice))
    pdf_report = vera.validate(EN16931::PDF.render(invoice, **options))
    puts format("%<name>-28s %<xml>-10s %<pdf>-10s", name: name, xml: xml_report.valid? ? "valid" : "INVALID", pdf: pdf_report.valid? ? "valid" : "INVALID")
    [xml_report, pdf_report].reject(&:valid?).each { |r| puts r.to_s.lines.map { |l| "    #{l}" }.join }
    failed ||= !(xml_report.valid? && pdf_report.valid?)
  end
  abort "validation failed" if failed
end

CLDR_VERSION = "45.0.0"

desc "Fetch the country names in every invoice language from CLDR #{CLDR_VERSION} into data/countries.yml"
task :countries do
  require "json"
  require "net/http"
  require "yaml"
  $LOAD_PATH.unshift File.expand_path("lib", __dir__)
  require "en16931"
  short = %w[HK MO PS] # the full names ("Sonderverwaltungsregion Hongkong") do not fit an address
  names = EN16931::PDF::Renderer::LABELS.keys.to_h do |locale|
    url = URI("https://cdn.jsdelivr.net/npm/cldr-localenames-full@#{CLDR_VERSION}/main/#{locale}/territories.json")
    territories = JSON.parse(Net::HTTP.get(url)).dig("main", locale.to_s, "localeDisplayNames", "territories")
    countries = territories.keys.grep(/\A[A-Z]{2}\z/) - %w[EU EZ UN QO XA XB ZZ]
    [locale.to_s, countries.sort.to_h { |code| [code, territories[short.include?(code) ? "#{code}-alt-short" : code]] }]
  end
  File.write("data/countries.yml", "# Generated by `rake countries` from CLDR #{CLDR_VERSION}, do not edit.\n#{names.to_yaml}")
end
